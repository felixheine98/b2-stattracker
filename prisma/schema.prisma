generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  PLAYER
}

enum PlayerStatus {
  MEMBER
  GUEST
}

enum Format {
  ROUND_1V1
  ROUND_2V2
  ROUND_3V3
  ROUND_4V4
  ROUND_5V5
  TIME_ATTACK_10
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String   @unique
  name      String
  password  String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   Player? @relation(fields: [playerId], references: [id])
  playerId String? @unique
}

model Player {
  id        String   @id @default(cuid())
  tmId      String   @unique
  name      String
  country   String?
  // Result of the last comparison with trackmania.io; null name after a check = not found
  tmioName             String?
  tmioCountry          String?
  tmioCheckedAt        DateTime?
  // trackmania.io values the user chose to ignore; a hint returns only when they change
  dismissedTmioName    String?
  dismissedTmioCountry String?
  // Status the player has "from the beginning"; later switches are PlayerStatusChange rows
  initialStatus PlayerStatus @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusChanges         PlayerStatusChange[]
  user                  User?
  lineupSlots           LineupSlot[]
  roundResults          RoundResult[]
  tournamentLineupSlots TournamentLineupSlot[]
}

// A switch between team member and guest, valid from the given day on
model PlayerStatusChange {
  id            String       @id @default(cuid())
  playerId      String
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status        PlayerStatus
  effectiveFrom DateTime     @db.Date
  createdAt     DateTime     @default(now())

  @@unique([playerId, effectiveFrom])
}

model Tournament {
  id          String    @id @default(cuid())
  name        String
  formats     Format[]
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  matches         Match[]
  tournamentLineups TournamentLineup[]
}

model TournamentLineup {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  slots   TournamentLineupSlot[]
  matches Match[]
}

model TournamentLineupSlot {
  id       String           @id @default(cuid())
  lineupId String
  lineup   TournamentLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player           @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

model Match {
  id                  String            @id @default(cuid())
  tournamentId        String
  tournament          Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentLineupId  String?
  tournamentLineup    TournamentLineup? @relation(fields: [tournamentLineupId], references: [id], onDelete: SetNull)
  isSeeding           Boolean           @default(false)
  opponent            String?
  date                DateTime?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  subMatches SubMatch[]
}

model SubMatch {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  format    Format
  order     Int
  createdAt DateTime @default(now())

  lineup Lineup?
  rounds Round[]

  @@unique([matchId, order])
}

model Lineup {
  id         String    @id @default(cuid())
  subMatchId String    @unique
  subMatch   SubMatch  @relation(fields: [subMatchId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  slots LineupSlot[]
}

model LineupSlot {
  id       String @id @default(cuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

model Round {
  id         String    @id @default(cuid())
  subMatchId String
  subMatch   SubMatch  @relation(fields: [subMatchId], references: [id], onDelete: Cascade)
  number     Int
  track      String?
  timestamp  DateTime?
  createdAt  DateTime  @default(now())

  results RoundResult[]

  @@unique([subMatchId, number])
}

model RoundResult {
  id         String  @id @default(cuid())
  roundId    String
  round      Round   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerId   String?
  player     Player? @relation(fields: [playerId], references: [id])
  tmId       String
  playerName String
  timeMs     Int?
  position   Int?
  isOurTeam  Boolean @default(false)

  @@unique([roundId, tmId])
}
