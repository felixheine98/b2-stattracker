generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  PLAYER
}

enum PlayerStatus {
  MEMBER
  GUEST
  // On trial: planned like a member, but not one yet
  TRIAL
  // No longer with the team; keeps profile and results but is not picked any more
  FORMER
}

enum Format {
  ROUND_1V1
  ROUND_2V2
  ROUND_3V3
  ROUND_4V4
  ROUND_5V5
  TIME_ATTACK_10
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String   @unique
  name      String
  password  String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   Player? @relation(fields: [playerId], references: [id])
  playerId String? @unique

  managedLineups TournamentLineupManager[]
  planningVotes  PlanningVote[]
}

model Player {
  id        String   @id @default(cuid())
  tmId      String   @unique
  // Opponent identities share the person table, but are excluded from our pool.
  // Unconfirmed names get a scoped unknown-* key until a TM.io assignment is confirmed.
  isOpponentOnly Boolean @default(false)
  opponentNames String[] @default([])
  // The current name; kept in step with the name history (initialName plus nameChanges)
  name      String
  // Readable address of the profile page, derived from the name (see lib/slugs-db.ts); none for opponent-only people
  slug      String?  @unique
  // Name the player has "from the beginning"; later renames are PlayerNameChange rows
  initialName String
  country   String?
  // Result of the last comparison with trackmania.io; null name after a check = not found
  tmioName             String?
  tmioCountry          String?
  tmioCheckedAt        DateTime?
  // trackmania.io values the user chose to ignore; a hint returns only when they change
  dismissedTmioName    String?
  dismissedTmioCountry String?
  // Status the player has "from the beginning"; later switches are PlayerStatusChange rows
  initialStatus PlayerStatus @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusChanges         PlayerStatusChange[]
  nameChanges           PlayerNameChange[]
  planningEntries       PlanningEntry[]
  planningSlots         PlanningVariantSlot[]
  user                  User?
  lineupSlots           LineupSlot[]
  roundResults          RoundResult[]
  tournamentLineupSlots TournamentLineupSlot[]
  opponentTeamSlots     OpponentTeamSlot[]
  opponentLineupSlots   OpponentLineupSlot[]
  opponentIdentities    OpponentIdentity[]
}

// A switch between team member and guest, valid from the given day on
model PlayerStatusChange {
  id            String       @id @default(cuid())
  playerId      String
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status        PlayerStatus
  effectiveFrom DateTime     @db.Date
  createdAt     DateTime     @default(now())

  @@unique([playerId, effectiveFrom])
}

// A rename, valid from the given day on
model PlayerNameChange {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  name          String
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([playerId, effectiveFrom])
}

model Tournament {
  id          String    @id @default(cuid())
  name        String
  // Readable address part, derived from the name (see lib/slugs.ts); null until first computed
  slug        String?   @unique
  formats     Format[]
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  matches         Match[]
  tournamentLineups TournamentLineup[]
  stages          Stage[]
  planning        Planning?
  opponentLineups OpponentLineup[]
}

// Planning a tournament before it has lineups: who is available and which lineups to build
// (see lib/planning.ts). Once the tournament has lineups the planning is a read-only archive.
model Planning {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // Counts every change to the planning; open pages ask for news with the number they last saw
  revision     Int        @default(0)
  // The variant whose lineups were taken over into the tournament
  adoptedVariantId String?          @unique
  adoptedVariant   PlanningVariant? @relation("AdoptedVariant", fields: [adoptedVariantId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  levels   PlanningLevel[]
  entries  PlanningEntry[]
  variants PlanningVariant[]
}

enum Availability {
  FIX
  MAYBE
  OUT
}

// An extra availability level of one planning, next to the fixed ones (e.g. "nur Ersatz")
model PlanningLevel {
  id         String   @id @default(cuid())
  planningId String
  planning   Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  entries PlanningEntry[]

  @@unique([planningId, name])
}

// What a player answered. Members are on the list without a row; a guest is on it through one.
// status and levelId are both empty until answered, otherwise exactly one is set.
model PlanningEntry {
  id         String         @id @default(cuid())
  planningId String
  planning   Planning       @relation(fields: [planningId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     Availability?
  levelId    String?
  level      PlanningLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  note       String?
  updatedAt  DateTime       @updatedAt

  @@unique([planningId, playerId])
}

// A complete proposal for the lineups of a tournament; admins and managers build several and agree on one
model PlanningVariant {
  id         String   @id @default(cuid())
  planningId String
  planning   Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  name       String
  note       String?
  createdAt  DateTime @default(now())

  adoptedBy Planning? @relation("AdoptedVariant")
  lineups PlanningVariantLineup[]
  slots   PlanningVariantSlot[]
  votes   PlanningVote[]
}

model PlanningVariantLineup {
  id        String          @id @default(cuid())
  variantId String
  variant   PlanningVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String
  note      String?
  createdAt DateTime        @default(now())

  slots PlanningVariantSlot[]
}

// A player in a variant: the lineup they are placed in (none: "not assigned") and a note on them.
// The note stays when the player is moved or their lineup is removed.
model PlanningVariantSlot {
  id        String                @id @default(cuid())
  variantId String
  variant   PlanningVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lineupId  String?
  lineup    PlanningVariantLineup? @relation(fields: [lineupId], references: [id], onDelete: SetNull)
  playerId  String
  player    Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime              @default(now())

  @@unique([variantId, playerId])
}

// A manager's thumbs-up for a variant
model PlanningVote {
  id        String          @id @default(cuid())
  variantId String
  variant   PlanningVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([variantId, userId])
}

enum StageType {
  SEEDING
  GROUP
  PLAYOFF
}

// A tournament is divided into stages: an optional seeding, the match days of the group
// phase and the playoffs. Names and dates are derived (see lib/stages.ts).
model Stage {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  type         StageType
  // Position among the stages of the same type, starting at 1
  number       Int
  createdAt    DateTime   @default(now())

  matches Match[]

  @@unique([tournamentId, type, number])
}

model TournamentLineup {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  slug         String?
  createdAt    DateTime   @default(now())

  slots    TournamentLineupSlot[]
  matches  Match[]
  managers TournamentLineupManager[]

  @@unique([tournamentId, slug])
}

// An account responsible for a lineup. A player account in here is a "lineup manager": it may
// maintain the matches and results of this one lineup (see lib/lineup-access.ts).
model TournamentLineupManager {
  id        String           @id @default(cuid())
  lineupId  String
  lineup    TournamentLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([lineupId, userId])
}

model TournamentLineupSlot {
  id       String           @id @default(cuid())
  lineupId String
  lineup   TournamentLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player           @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

model Match {
  id                  String            @id @default(cuid())
  tournamentId        String
  tournament          Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentLineupId  String?
  // Every match belongs to a lineup; a lineup with matches cannot be deleted
  tournamentLineup    TournamentLineup? @relation(fields: [tournamentLineupId], references: [id], onDelete: NoAction)
  slug                String?
  // Decides what kind of match this is; a match in the seeding stage is a seeding match
  stageId             String
  stage               Stage             @relation(fields: [stageId], references: [id], onDelete: NoAction)
  opponent            String?
  opponentLineupId    String?
  opponentLineup      OpponentLineup? @relation(fields: [opponentLineupId], references: [id], onDelete: Restrict)
  closedAt            DateTime?
  confirmedOutcome    String?
  // Increased within result writes, so confirmation cannot race with an import.
  resultRevision      Int @default(0)
  date                DateTime?
  notes               String?
  // eCircuitMania match page the results were imported from
  ecmUrl              String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  subMatches SubMatch[]
  confirmations MatchConfirmation[]

  @@unique([tournamentLineupId, slug])
}

model OpponentTeam {
  id           String @id @default(cuid())
  name         String
  aliases      String[] @default([])
  logo         String?
  archived     Boolean @default(false)
  source       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lineups      OpponentLineup[]
  slots        OpponentTeamSlot[]
}

model OpponentLineup {
  id           String @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String?
  team         OpponentTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  name         String
  nameKey      String
  aliases      String[] @default([])
  logo         String?
  notes        String?
  archived     Boolean @default(false)
  previousId   String?
  previous     OpponentLineup? @relation("OpponentContinuity", fields: [previousId], references: [id], onDelete: SetNull)
  next         OpponentLineup[] @relation("OpponentContinuity")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  slots        OpponentLineupSlot[]
  identities   OpponentIdentity[]
  matches      Match[]

  @@unique([tournamentId, nameKey])
}

model OpponentTeamSlot {
  id       String @id @default(cuid())
  teamId   String
  team     OpponentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@unique([teamId, playerId])
}

model OpponentLineupSlot {
  id       String @id @default(cuid())
  lineupId String
  lineup   OpponentLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@unique([lineupId, playerId])
}

// Keeps confirmed identity assignments through replacement imports, independently of the planned roster.
model OpponentIdentity {
  id         String @id @default(cuid())
  lineupId   String
  lineup     OpponentLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  sourceId   String
  playerId   String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@unique([lineupId, sourceId])
}

model MatchConfirmation {
  id       String @id @default(cuid())
  matchId  String
  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  outcome  String
  revision Int
  userId   String
  createdAt DateTime @default(now())
}

enum SlugKind {
  TOURNAMENT
  LINEUP
  MATCH
  PLAYER
}

// A former address of a tournament, lineup or match, so old links keep working after a rename.
// scopeId is what the slug was unique in: "" for tournaments and players, the tournament for lineups, the lineup for matches.
model SlugAlias {
  id        String   @id @default(cuid())
  kind      SlugKind
  scopeId   String
  slug      String
  targetId  String
  createdAt DateTime @default(now())

  @@unique([kind, scopeId, slug])
}

model SubMatch {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  format    Format
  order     Int
  createdAt DateTime @default(now())

  lineup Lineup?
  rounds Round[]

  @@unique([matchId, order])
}

model Lineup {
  id         String    @id @default(cuid())
  subMatchId String    @unique
  subMatch   SubMatch  @relation(fields: [subMatchId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  slots LineupSlot[]
}

model LineupSlot {
  id       String @id @default(cuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

model Round {
  id         String    @id @default(cuid())
  subMatchId String
  subMatch   SubMatch  @relation(fields: [subMatchId], references: [id], onDelete: Cascade)
  number     Int
  track      String?
  timestamp  DateTime?
  createdAt  DateTime  @default(now())

  results RoundResult[]

  @@unique([subMatchId, number])
}

model RoundResult {
  id         String  @id @default(cuid())
  roundId    String
  round      Round   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerId   String?
  player     Player? @relation(fields: [playerId], references: [id])
  tmId       String
  playerName String
  timeMs     Int?
  // Did not finish: placed last and scores no points
  dnf        Boolean @default(false)
  position   Int?
  isOurTeam  Boolean @default(false)

  @@unique([roundId, tmId])
}
